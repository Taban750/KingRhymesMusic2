# Supabase: copy the exact Transaction pooler URI (port 6543) from Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&uselibpqcompat=true
# Use Supabase's direct URI for local Drizzle schema changes/migration tools.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=artist@example.com
ADMIN_SETUP_TOKEN=replace-with-a-long-random-token
ADMIN_PASSWORD=replace-with-a-secure-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=King Rhymes <no-reply@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FLW_SECRET_KEY=
FLW_SECRET_HASH=

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret-key
SUPABASE_PUBLIC_MEDIA_BUCKET=media-public
SUPABASE_PRIVATE_MEDIA_BUCKET=media-private
SUPABASE_MAX_FILE_SIZE_BYTES=52428800
